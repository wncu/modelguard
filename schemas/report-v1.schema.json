{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelGuard MVP report v1",
  "type": "object",
  "required": ["schema_version", "scanner_version", "created_at", "target", "status", "files", "findings", "coverage", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scanner_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "target": {"type": "string"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "insufficient_evidence"},
    "files": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "size": {"type": ["integer", "null"], "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "declared_lfs_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["rule", "severity", "file", "message"], "properties": {"rule": {"type": "string"}, "severity": {"const": "review"}, "file": {"type": "string"}, "message": {"type": "string"}}}},
    "coverage": {"type": "object", "required": ["inventory", "content", "behavior", "weights"], "properties": {"inventory": {"type": "boolean"}, "content": {"type": "boolean"}, "behavior": {"type": "boolean"}, "weights": {"type": "boolean"}}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
